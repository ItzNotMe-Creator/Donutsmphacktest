{
  "schemaVersion": 1,
  "id": "wurst",
  "version": "${version}",
  "name": "Donut Client (Wurst-based)",
  "description": "Customized Wurst-based client with the Donut dashboard. GPL-3.0-or-later; original modules by Wurst-Imperium and contributors.",
  "authors": [
    "Alexander01998"
  ],
  "contact": {
    "homepage": "https://www.wurstclient.net/modmenu-homepage/",
    "sources": "https://github.com/ItzNotMe-Creator/Donutsmphacktest/tree/main/client",
    "issues": "https://www.wurstclient.net/modmenu-issues/"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/wurst/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "net.wurstclient.WurstInitializer"
    ]
  },
  "mixins": [
    "wurst.mixins.json"
  ],
  "accessWidener": "wurst.accesswidener",
  "depends": {
    "fabricloader": ">=0.17.3",
    "fabric-api": ">=0.140.0",
    "minecraft": "1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "mo_glass": "*"
  },
  "conflicts": {
    "betterblockentities": ">=1.3.2 <1.3.4"
  },
  "breaks": {
    "wi_zoom": "*",
    "wi-zoom": "*",
    "vulkanmod": "*"
  },
  "custom": {
    "badoptimizations:cache_hooks": {
      "lightmap": "net.wurstclient.hacks.fullbright.BadOptimizationsLightmapHook"
    },
    "modmenu": {
      "links": {
        "modmenu.donate": "https://www.wurstclient.net/modmenu-donate/",
        "modmenu.twitter": "https://www.wurstclient.net/modmenu-twitter/",
        "modmenu.wiki": "https://www.wurstclient.net/modmenu-wiki/",
        "Forum": "https://www.wurstclient.net/modmenu-forum/"
      }
    }
  }
}
